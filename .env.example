# MockAPI endpoint (leave empty to use local fallback data)
VITE_MOCKAPI_URL=https://your-mockapi-id.mockapi.io/

# EmailJS credentials (for sending interview / status notification emails)
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Contact recipient email
VITE_CONTACT_EMAIL=support@careerhub.example.com
